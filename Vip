    CFG.MinValue = math.max(0, CFG.MinValue - 100)
    btnMinP.Text = "Min "..CFG.MinValue
end)
btnMinM.MouseButton1Click:Connect(function()
    CFG.MinValue = CFG.MinValue + 100
    btnMinM.Text = "Min "..CFG.MinValue
end)

-- drag
local dragging, dStart, dPos
title.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true; dStart = i.Position; dPos = main.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
        local d = i.Position - dStart
        main.Position = UDim2.new(dPos.X.Scale, dPos.X.Offset + d.X, dPos.Y.Scale, dPos.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

-- ===== 6. LOOPS =====
RunService.Stepped:Connect(function()
    if not CFG.Noclip then return end
    local char = player.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = false end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(CFG.Interval)
        status.Text = statusText
        if CFG.AutoSteal then pcall(stealOnce) end
    end
end)

log("v0.3 loaded - GUI top-left")
