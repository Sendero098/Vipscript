if getgenv().__HERESY_BUSY then
    print("[HERESY] a load is already in progress, chill")
    return
end
getgenv().__HERESY_BUSY = true

local GENV        = (getgenv and getgenv()) or _G
local THE_KEY     = "ricardo"                        -- <-- your key
local KEY_FILE    = "heresy_key.txt"
local CACHE_FILE  = "heresy_payload.lua"
local DUMP_FILE   = "heresy_patched.lua"
local HUB_URL     = "https://rscripts.net/raw/heresy-hub_1787244974345_Jd8pKhM6sx.txt"
local TRIES       = 4
local APPLY_PATCH = true
local DUMP_PATCHED= false     -- true = save the patched payload to your workspace folder
local FPS_CAP     = 240       -- 999 = hub default

local HAS_FS = typeof(writefile) == "function"
           and typeof(readfile)  == "function"
           and typeof(isfile)    == "function"

local function norm(s) return tostring(s or ""):gsub("%s+", ""):lower() end

-- escape magic chars so gsub treats find/repl as literal text
local function esc(s)
    return (tostring(s):gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%1"))
end

-- ================================================================
--  PATCH TABLE   (each entry: exact source text -> fixed text)
-- ================================================================
local PATCHES = {

    {   -- stops a second `while true do task.wait(45)` spam loop on re-execute
        name = "duplicate troll loop on re-run",
        find = "if not _G.SXEFreeVerboso then\n",
