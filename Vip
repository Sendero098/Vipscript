updRemote()

btnSteal.MouseButton1Click:Connect(function()
    CFG.AutoSteal = not CFG.AutoSteal
    btnSteal.Text = "Auto Steal: " .. (CFG.AutoSteal and "ON" or "OFF")
    btnSteal.BackgroundColor3 = CFG.AutoSteal and Color3.fromRGB(35,90,55) or Color3.fromRGB(42,42,52)
end)
btnRemote.MouseButton1Click:Connect(function()
    if #StealRemotes == 0 then return end
    RemoteIndex = (RemoteIndex % #StealRemotes) + 1
    updRemote()
end)
btnScan.MouseButton1Click:Connect(function()
    local l = scan()
    status.Text = ("targets: %d  best: %s"):format(#l, l[1] and l[1].obj.Name or "none")
    log("scan:", #l, "targets")
end)
btnProbe.MouseButton1Click:Connect(function() task.spawn(probe) end)
