--=========== LOOP GOTO  (the anti-teleport) ====================
local GOTO = { on = false, pos = nil }

local function gotoSet(pos, yoff)
    if not pos then return end
    GOTO.pos = pos + Vector3.new(0, yoff or 2, 0)
    GOTO.on = true
    local hrp = getHRP()
    if hrp then hrp.CFrame = CFrame.new(GOTO.pos) end
end
local function gotoStop() GOTO.on = false; GOTO.pos = nil end

bind(RunService.RenderStepped:Connect(function()
    if not GOTO.on or not GOTO.pos or not alive() then return end
    local hrp = getHRP()
    if not hrp then return end
    if (hrp.Position - GOTO.pos).Magnitude > 1.5 then
        hrp.CFrame = CFrame.new(GOTO.pos)
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
    end
end))

local function tpTo(pos, yOff, safe)
    local hrp = getHRP(); if not hrp or not pos then return end
    local target = CFrame.new(pos + Vector3.new(0, yOff or 2, 0))
    if safe == nil then safe = S.safeTP end
    if safe then hrp.Anchored = true; hrp.CFrame = target; task.wait(0.05); hrp.Anchored = false
    else hrp.CFrame = target end
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
end

