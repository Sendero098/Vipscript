        name = "fireClick hardcoded +58 y-offset",
        find = "local y=button.AbsolutePosition.Y+(button.AbsoluteSize.Y/2)+58",
        repl = "local y=button.AbsolutePosition.Y+(button.AbsoluteSize.Y/2)"
            .. "+(game:GetService(\"GuiService\"):GetGuiInset().Y)",
    },
}

local function applyPatches(src)
    local report = {}
    src = src:gsub("\r\n", "\n")               -- normalise line endings first
    for _, p in ipairs(PATCHES) do
        local n
        src, n = src:gsub(esc(p.find), esc(p.repl))
        report[#report + 1] = { name = p.name, hits = n }
    end
    return src, report
end

-- ================================================================
--  fetch + cache
-- ================================================================
local function fetchPayload()
    for i = 1, TRIES do
        local u = (i == 1) and HUB_URL
                  or (HUB_URL .. "?cb=" .. tostring(os.time()) .. "_" .. i)
        local ok, body = pcall(game.HttpGet, game, u, true)
        if ok and type(body) == "string" and #body > 200 then return body, i end
        task.wait(0.6 * i)
    end
end

local function cacheRead()
    if not HAS_FS then return nil end
    local ok, s = pcall(function()
        if isfile(CACHE_FILE) then return readfile(CACHE_FILE) end
    end)
    if ok and type(s) == "string" and #s > 200 then return s end
end

local function cacheWrite(s)
    if HAS_FS then pcall(function() writefile(CACHE_FILE, s) end) end
end

-- ================================================================
--  run
-- ================================================================
local function start()
    local src, attempt = fetchPayload()
    if src then
        print(("[HERESY] payload fetched (attempt %d, %d bytes)"):format(attempt, #src))
        cacheWrite(src)
    else
        src = cacheRead()
        if src then
            print("[HERESY] rscripts unreachable - using cached payload")
        else
            print("[HERESY] rscripts unreachable and no cache. try again.")
            GENV.__HERESY_BUSY = false
            return
        end
    end

    if APPLY_PATCH then
        local report
        src, report = applyPatches(src)
        local applied, missed = 0, {}
        for _, r in ipairs(report) do
            if r.hits > 0 then applied = applied + 1
            else missed[#missed + 1] = r.name end
        end
        print(("[HERESY] patches: %d/%d applied"):format(applied, #PATCHES))
        if #missed > 0 then
            print("[HERESY] WARNING - these patches no longer match (upstream changed?):")
            for _, m in ipairs(missed) do print("[HERESY]   * " .. m) end
        end
        if DUMP_PATCHED and HAS_FS then
            pcall(function() writefile(DUMP_FILE, src) end)
            print("[HERESY] patched payload written to " .. DUMP_FILE)
        end
    end

    if not game:IsLoaded() then game.Loaded:Wait() end
    GENV.SXE_FPS_CAP = FPS_CAP

    local chunk, cerr = (loadstring or load)(src)
    if not chunk then
        print("[HERESY] compile error: " .. tostring(cerr))
        GENV.__HERESY_BUSY = false
        return
    end

    local ok, rerr = pcall(chunk)
    if not ok then print("[HERESY] payload runtime error: " .. tostring(rerr)) end

    -- safety net in case the source patch for this ever misses
    if not GENV.ShowNotification then
        GENV.ShowNotification = function(t, m)
            print(("[HERESY] %s - %s"):format(tostring(t), tostring(m)))
        end
   
