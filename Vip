--[[ SAB AutoSteal v0.3 - GUI + Net API probe - keyless / Delta mobile ]]

local Players     = game:GetService("Players")
local RS          = game:GetService("ReplicatedStorage")
local RunService  = game:GetService("RunService")
local UIS         = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local TeleportSvc = game:GetService("TeleportService")
local player      = Players.LocalPlayer

local CFG = {
    AutoSteal = false, Interval = 0.2, MinValue = 0,
    Teleport = true, AntiCheat = true, Noclip = true, Desync = false,
}
getgenv().SAB = CFG
local function log(...) print("[SAB]", ...) end

-- ===== 1. ANTI-CHEAT =====
if CFG.AntiCheat then
    local hooked = false
    pcall(function()
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" and not hooked then
                local orig = rawget(v, "observeTag")
                if type(orig) == "function" then
                    hooked = true
                    rawset(v, "observeTag", function(...)
                        local ok, conn = pcall(orig, ...)
                        local stub = { Disconnect = function() end, disconnect = function() end }
                        if ok and type(conn) == "table" then
                            stub.Connected = true
                            setmetatable(stub, {
                                __index = function(_, k)
                                    local val = conn[k]
                                    if type(val) == "function" then
                                        return function(_, ...) return val(conn, ...) end
                                    end
                                    return val
                                end,
                            })
                        end
                        return stub
                    end)
                end
            end
        end
    end)
    log("observeTag wrapped:", hooked)

    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        if setreadonly then setreadonly(mt, false) end
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "Kick" and self == player then return end
            if m == "FireServer" then
                local a = ...
                if type(a) == "string" then
                    local s = a:lower()
                    if s == "x-15" or s == "x-16" then return end
                end
            end
            return old(self, ...)
        end)
        if setreadonly then setreadonly(mt, true) end
    end)
end

-- ===== 2. NET REMOTES =====
local function getNet()
    for _, o in ipairs(RS:GetDescendants()) do
        if o:IsA("Folder") and o.Name == "Net" then return o end
    end
end

local NetFolder = getNet()
local StealRemotes, RemoteIndex = {}, 1

local function refreshRemotes()
    StealRemotes = {}
    if not NetFolder then NetFolder = getNet() end
    if not NetFolder then return end
    for _, o in ipairs(NetFolder:GetDescendants()) do
        if o:IsA("RemoteEvent") and o.Name:lower():find("steal") then
            StealRemotes[#StealRemotes+1] = o
        end
    end
    table.sort(StealRemotes, function(a,b) return a.Name < b.Name end)
    RemoteIndex = math.clamp(RemoteIndex, 1, math.max(#StealRemotes, 1))
    log("steal remotes:", #StealRemotes)
    for i, r in ipairs(StealRemotes) do log("  ["..i.."]", r.Name) end
end
refreshRemotes()

local function currentRemote() return StealRemotes[RemoteIndex] end

-- ===== 3. SCAN =====
local function getOwner(o)
    local v = o:FindFirstChild("Owner")
    if v and (v:IsA("ObjectValue") or v:IsA("StringValue")) then return v.Value end
    return o:GetAttribute("Owner")
end
local function getValue(o)
    for _, n in ipairs({"Value","Price","Worth","Cost"}) do
        local v = o:FindFirstChild(n)
        if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then return v.Value end
    end
    return o:GetAttribute("Value") or o:GetAttribute("Price") or 0
end
local function scan()
    local out = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and (o:FindFirstChild("Owner") or o.Name:lower():find("brainrot")) then
            local owner = getOwner(o)
            if owner and owner ~= player then
                local val = getValue(o)
                if val >= CFG.MinValue then
                    local root = o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
                    if root then out[#out+1] = {obj=o, val=val, root=root} end
                end
            end
        end
    end
    table.sort(out, function(a,b) return a.val > b.val end)
    return out
end

-- ===== 4. ACTIONS =====
local statusText = "idle"

local function goTo(t)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and CFG.Teleport then hrp.CFrame = t.root.CFrame * CFrame.new(0,3,0) end
    return hrp
end

local function stealOnce()
    local t = scan()[1]
    if not t then statusText = "no target"; return end
    local r = currentRemote()
    if not r then statusText = "no remote"; return end
    local hrp = goTo(t)
    if not hrp then return end
    if CFG.Desync then hrp.Anchored = true end
    r:FireServer(t.obj)
    if CFG.Desync then task.wait(); hrp.Anchored = false end
    statusText = "steal -> " .. t.obj.Name
end

local function probe()
    local t = scan()[1]
    if not t then statusText = "probe: no target"; return end
    goTo(t); task.wait(0.3)
    log("=== PROBE on", t.obj.Name, "value", t.val, "===")
    for _, r in ipairs(StealRemotes) do
        pcall(function() r:FireServer(t.obj) end)
        log("fired ->", r.Name)
        task.wait(0.5)
    end
    statusText = "probe done - watch which one worked"
    log("=== PROBE END ===")
end

local function hop()
    local ok, body = pcall(game.HttpGet, game,
        ("https://games.roblox.com/v1/games/%d/servers/Public?limit=100"):format(game.GameId))
    if not ok then return end
    local list = {}
    for _, s in ipairs(HttpService:JSONDecode(body).data or {}) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then list[#list+1] = s end
    end
    if #list > 0 then TeleportSvc:TeleportToPlaceInstance(game.PlaceId, list[1].id, player) end
end

