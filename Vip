--[[ SAB AutoSteal v0.2 - keyless, mobile/Delta friendly
     FIX: observeTag is now WRAPPED (original still runs), not replaced ]]

local Players      = game:GetService("Players")
local RS           = game:GetService("ReplicatedStorage")
local RunService   = game:GetService("RunService")
local HttpService  = game:GetService("HttpService")
local TeleportSvc  = game:GetService("TeleportService")
local player       = Players.LocalPlayer

local CFG = {
    AutoSteal = true, Interval = 0.25, MinValue = 0,
    Teleport = true, AntiCheat = true, Noclip = true, Desync = false,
    Debug = true,
}
getgenv().SAB = CFG

local function log(...) if CFG.Debug then print("[SAB]", ...) end end

------------------------------------------------------------------
-- 1. ANTI-CHEAT (observeTag WRAPPED so the AC's callback still runs)
------------------------------------------------------------------
if CFG.AntiCheat then
    local hooked = false
    pcall(function()
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" and not hooked then
                local orig = rawget(v, "observeTag")
                if type(orig) == "function" then
                    hooked = true
                    rawset(v, "observeTag", function(...)
                        local ok, conn = pcall(orig, ...)
                        local stub = { Disconnect = function() end, disconnect = function() end }
                        if ok and type(conn) == "table" then
                            stub.Connected = true
                            stub.__conn = conn
                            setmetatable(stub, {
                                __index = function(_, k)
                                    local val = conn[k]
                                    if type(val) == "function" then
                                        return function(_, ...) return val(conn, ...) end
                                    end
                                    return val
                                end,
                            })
                        end
                        return stub
                    end)
                end
            end
        end
    end)
    log("observeTag wrapped:", hooked)

    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        if setreadonly then setreadonly(mt, false) end
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "Kick" and self == player then return end
            if m == "FireServer" then
                local a = ...
                if type(a) == "string" then
                    local s = a:lower()
                    if s == "x-15" or s == "x-16" then return end
                end
            end
            return old(self, ...)
        end)
        if setreadonly then setreadonly(mt, true) end
        log("kick + flag hook installed")
    end)
end

------------------------------------------------------------------
-- 2. FIND THE STEAL REMOTE AT RUNTIME
------------------------------------------------------------------
local function resolveStealRemote()
    for _, root in ipairs({ RS, RS:FindFirstChild("Remotes"), RS:FindFirstChild("Events"),
                            RS:FindFirstChild("RemoteEvents"), RS:FindFirstChild("Net") }) do
        if root then
            for _, o in ipairs(root:GetDescendants()) do
                if o:IsA("RemoteEvent") and o.Name:lower():find("steal") then return o end
            end
        end
    end
end

local StealRemote
task.spawn(function()
    while not StealRemote do
        StealRemote = resolveStealRemote()
        if not StealRemote then task.wait(1) end
    end
    getgenv().SAB_StealRemote = StealRemote
    log("STEAL REMOTE ->", StealRemote:GetFullName())
end)

------------------------------------------------------------------
-- 3. SCAN BRAINROTS
------------------------------------------------------------------
local function getOwner(o)
    local v = o:FindFirstChild("Owner")
    if v and (v:IsA("ObjectValue") or v:IsA("StringValue")) then return v.Value end
    return o:GetAttribute("Owner")
end

local function getValue(o)
    for _, n in ipairs({"Value","Price","Worth","Cost"}) do
        local v = o:FindFirstChild(n)
        if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then return v.Value end
    end
    return o:GetAttribute("Value") or o:GetAttribute("Price") or 0
end

local function scan()
    local out = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and (o:FindFirstChild("Owner") or o.Name:lower():find("brainrot")) then
            local owner = getOwner(o)
            if owner and owner ~= player then
                local val = getValue(o)
                if val >= CFG.MinValue then
                    local root = o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
                    if root then out[#out+1] = {obj=o, val=val, root=root} end
                end
            end
        end
    end
    table.sort(out, function(a,b) return a.val > b.val end)
    return out
end

------------------------------------------------------------------
-- 4. STEAL
------------------------------------------------------------------
local function stealOnce()
    local list = scan()
    local t = list[1]
    if not t or not StealRemote then return end
    local char = player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if CFG.Teleport then hrp.CFrame = t.root.CFrame * CFrame.new(0, 3, 0) end
    if CFG.Desync then hrp.Anchored = true end
    StealRemote:FireServer(t.obj)
    if CFG.Desync then task.wait(); hrp.Anchored = false end
end

------------------------------------------------------------------
-- 5. LOOPS
------------------------------------------------------------------
RunService.Stepped:Connect(function()
    if not CFG.Noclip then return end
    local char = player.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = false end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(CFG.Interval)
        if CFG.AutoSteal then pcall(stealOnce) end
    end
end)

------------------------------------------------------------------
-- 6. HOP + COMMANDS
------------------------------------------------------------------
local function hop()
    local ok, body = pcall(game.HttpGet, game,
        ("https://games.roblox.com/v1/games/%d/servers/Public?limit=100"):format(game.GameId))
    if not ok then return end
    local list = {}
    for _, s in ipairs(HttpService:JSONDecode(body).data or {}) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then list[#list+1] = s end
    end
    if #list > 0 then TeleportSvc:TeleportToPlaceInstance(game.PlaceId, list[1].id, player) end
end

player.Chatted:Connect(function(msg)
    local m = msg:lower()
    if m == "/sab off" then CFG.AutoSteal = false; log("steal OFF")
    elseif m == "/sab on" then CFG.AutoSteal = true; log("steal ON")
    elseif m == "/sab hop" then hop()
    elseif m == "/sab tp" then CFG.Teleport = not CFG.Teleport; log("tp:", CFG.Teleport)
    elseif m == "/sab desync" then CFG.Desync = not CFG.Desync; log("desync:", CFG.Desync)
    elseif m == "/sab scan" then
        local l = scan()
        log("targets:", #l, "best:", l[1] and l[1].obj.Name or "none", l[1] and l[1].val or "")
    elseif m == "/sab help" then log("/sab on|off|hop|tp|desync|scan|help") end
end)

log("v0.2 loaded")
